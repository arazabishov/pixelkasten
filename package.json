{
  "name": "pixelkasten",
  "version": "0.0.1",
  "description": "A script that helps you organize and manage your photo archive.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "pixelkasten": "./src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test --experimental-test-module-mocks 'test/core/**/*.test.js' 'test/handlers/**/*.test.js' 'test/stages/**/*.test.js'",
    "test:integration": "node --test --experimental-test-module-mocks 'test/integration/**/*.test.js'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arazabishov/pixelkasten.git"
  },
  "author": "Araz Abishov",
  "bugs": {
    "url": "https://github.com/arazabishov/pixelkasten/issues"
  },
  "homepage": "https://github.com/arazabishov/pixelkasten#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "globals": "^17.3.0",
    "prettier": "^3.6.2"
  },
  "dependencies": {
    "cli-progress": "^3.12.0",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.1",
    "csv-stringify": "^6.6.0",
    "execa": "^9.6.0"
  }
}
